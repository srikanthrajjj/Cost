# CostReno Environment Variables
# Copy this file to .env and fill in your values

# Sk AI API Key for chatbot functionality  
# Get your key from: https://openrouter.ai (try deepseek model - free)
VITE_SK_API_KEY=your_api_key_here

# Optional: Set to 'true' to enable debug mode
# VITE_DEBUG=false

# Optional: Custom API endpoint (defaults to OpenRouter)
# VITE_API_BASE_URL=https://openrouter.ai/api/v1
# CostReno Environment Variables
# Copy this file to .env and fill in your values

# OpenRouter API key (preferred for server functions)
# Get a key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Legacy alias still supported by the app
# VITE_SK_API_KEY=your_openrouter_api_key_here

# Optional model override (default: deepseek/deepseek-chat-v3-0324)
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Optional: Custom OpenAI-compatible API endpoint
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# VITE_API_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenStreetMap endpoints for roof footprint measurement (no API key required).
# Defaults: Nominatim + public Overpass. Override only if you run your own instances.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: Set to 'true' to enable debug mode
# VITE_DEBUG=false

# Resend API Key (server-side only — never exposed to the browser)
# Get your key from: https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Resend Audience ID (for newsletter subscribers)
# Create one at: https://resend.com/audiences
RESEND_AUDIENCE_ID=your_audience_id_here

# Optional: where quote feedback emails are delivered
# FEEDBACK_TO_EMAIL=notifications@costreno.com

# Database (recommended for production)
# Use a Neon Postgres connection string: https://neon.tech
# When unset, CostReno falls back to a local JSON file at data/costreno-store.json
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# After setting DATABASE_URL, create tables once:
#   psql "$DATABASE_URL" -f src/lib/db/schema.sql

# Simple admin dashboard password for /admin
# Defaults to test if unset. Change this in production.
# ADMIN_SECRET=test
